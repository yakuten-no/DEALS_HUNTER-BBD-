# === Secrets & environment ===
# Never commit real .env files -- only .env.example files are tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Anything that could hold session/auth state for a future browser-automation
# collector. Nothing here yet in V0.1, but the rule is set from day one.
**/browser-sessions/
**/*.session.json
**/cookies.json

# === Python (backend) ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Node (frontend) ===
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.vite/

# === Database ===
# The SQLite file is local runtime data, not source -- see database/README.md.
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# === Editors / OS ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# === Logs ===
*.log
npm-debug.log*

# Copy this file to .env in the same folder and adjust values as needed.
# .env is gitignored -- never commit it. Never put real secrets here
# either: V0.1 has no accounts, passwords, or API keys to configure yet.

# --- General ---
APP_NAME=bbd-hunter
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Leave unset to use the default local SQLite file at database/bbd_hunter.db.
# Uncomment to override (forward slashes work fine on Windows too):
# DATABASE_URL=sqlite:///./database/bbd_hunter.db

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Defaults match Vite's default dev server ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
